      "legal_instrument": "treaty",
      "legal_layer": "treaty",
      "article": "12",
      "paragraph": null,
      "rate": 10.0,
      "priority": 600,
      "conditions": [
        {
          "fact": "recipient_is_treaty_resident",
          "fact_source": "transaction",
          "operator": "==",
