        "rate_candidates": [
          {
            "conditions": [
              {
                "condition_type": "minimum_ownership",
                "operator": ">=",
                "unit": "%",
                "value": "10"
              },
              {
                "condition_type": "beneficial_owner",
                "operator": "==",
                "unit": null,
                "value": "true"
              }
            ],
            "legal_basis": "Article 10",
            "priority": 0,
            "rate": 0.0,
            "source_text": "0 procent hrubé Částky dividend, jestliže skutečným vlastníkem je společnost (jiná než osobní společnost), která přímo drží alespoň 10 procent kapitálu společnosti, která dividendy vyplácí;",
            "source_text_sha256": "777a7d3bdc3e8792837329991eef04b4aa92ce073d200b4c8f2aa6733adea495"
          },
          {
            "conditions": [
              {
                "condition_type": "beneficial_owner",
                "operator": "==",
                "unit": null,
                "value": "true"
              }
            ],
            "legal_basis": "Article 10",
            "priority": 1,
            "rate": 0.0,
            "source_text": "0 procent hrubé částky dividend, jestliže skutečným vlastníkem je penzijní fond nebo jiná podobná instituce poskytující penzijní plán, na kterém se mohou účastnit fyzické osoby za účelem zajištění důchodových dávek, pokud takový penzijní fond nebo jiná podobná instituce poskytuje plán v tomto druhém státě uznávaný pro daňové účely v souladu s článkem 17 odstavcem 2;",
            "source_text_sha256": "999ae14601ef8c604300d9726f4c89ab37f05a7bcfe8a5f89207d6f4cc75dea1"
          },
          {
            "conditions": [
              {
                "condition_type": "beneficial_owner",
                "operator": "==",
                "unit": null,
                "value": "true"
              }
            ],
            "legal_basis": "Article 10",
            "priority": 2,
            "rate": 15.0,
            "source_text": "15 procent hrubé částky dividend ve všech ostatních případech.\nPříslušné úřady smluvních států upraví vzájemnou dohodou způsob aplikace těchto omezení.\nTento odstavec se nedotýká zdanění zisků společnosti, z nichž jsou dividendy vypláceny.",
            "source_text_sha256": "472bb474b07967f2554cea936301265b5d3c61fb21eee3409042d5a5fcb67fcf"
          }
        ],
