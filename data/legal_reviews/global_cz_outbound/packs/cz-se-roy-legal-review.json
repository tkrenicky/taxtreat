          },
          {
            "conditions": [],
            "legal_basis": "Article 12",
            "priority": 1,
            "rate": 0.0,
            "source_text": "Licenční poplatky plynoucí z autorských\npráv k dílům literárním, uměleckým nebo vě-\ndeckým podléhají bez ohledu na ustanovení od-\nstavců 1 a 2 zdanění jen v tom smluvním státě,\nve kterém má příjemce takových licenčních po-\nplatků bydliště či sídlo.",
            "source_text_sha256": "30b03442b0a3f4aea5e52a8257383a48c7160113b2edf0d0702a22aea96a8356"
          }
