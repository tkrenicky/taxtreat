      "base_treaty": {
        "article_number": 12,
        "article_text_sha256": "f24e07663b0a2a7c7b9d8712ca83fb32a1d9dea082423ee8f15fc688ce78971a",
        "article_title": "Licenční poplatky",
        "candidate_status": "base_rate_candidate_extracted",
        "consolidation_blockers": [
          "domestic_and_eu_relief_consolidation",
          "independent_legal_review",
          "mli_effect_candidate_review",
          "semantic_rate_review"
        ],
        "discarded_rate_candidates": [],
        "publication": "23/1982 Sb.",
        "rate_candidates": [
          {
            "conditions": [],
            "legal_basis": "Article 12",
            "priority": 0,
            "rate": 5.0,
            "source_text": "Takové licenční poplatky však mohou být\nzdaněny ve smluvním státě, ve kterém je jejich\nzdroj, a to podle práva tohoto státu. Daň takto ulo-\nžená však nepřekročí 5 % hrubé částky licenčních\npoplatků za předpokladu, že licenční poplatky pod-\nléhají zdanění v druhém smluvním státě.",
            "source_text_sha256": "4d8ec853b613d3c306874d31d58d4bab6b656201ec65eeb55766e65fa014c284"
          },
          {
            "conditions": [],
            "legal_basis": "Article 12",
            "priority": 1,
            "rate": 0.0,
            "source_text": "Autorské licenční poplatky a jiné podobné\nplaty za provedení nebo reprodukci literárního,\ndramatického, hudebního nebo uměleckého díla\n(avšak s výjimkou licenčních poplatků placených\nza kinematografické filmy a díla nahraná na filmo-\nvé nebo televizní pásky pro televizní vysílání) ma-\njící zdroj v jednom smluvním státě a placené osobě\nmající bydliště či sídlo v druhém smluvním státě,\nkterá je podrobena zdanění z těchto licenčních po-\nplatků, podléhají zdanění pouze v tomto druhém\nstátě.",
            "source_text_sha256": "2222df9bbc4140eb5145737a503bb120b41d3a91298d54e88bc87f58359b6626"
          }
        ],
